{
  "env": {
    "es2021": true,
    "node": true,
    "vitest/globals": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["vitest"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["client/**/*.{js,jsx,ts,tsx}"],
      "extends": [
        "eslint:recommended",
        "plugin:react/recommended",
        "plugin:react-hooks/recommended"
      ],
      "env": {
        "browser": true,
        "es2021": true,
        "vitest/globals": true
      },
      "plugins": ["react", "react-hooks", "vitest"],
      "parserOptions": {
        "ecmaFeatures": {
          "jsx": true
        },
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/prop-types": "off",
        "no-irregular-whitespace": "warn",
        "no-useless-escape": "warn",
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_"
          }
        ]
      },
      "settings": {
        "react": {
          "version": "19.2.4"
        }
      }
    }
  ]
}
