{
  "name": "comida-emergencia-mini-server",
  "version": "4.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "pnpm --filter comida-emergencia-mini-cliente run dev",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\"",
    "cli": "node cli/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "prettierCheck": "prettier --check .",
    "prettierFix": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "push:all": "pnpm audit && pnpm test:run && pnpm prettierFix && pnpm lint && node scripts/push-all.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vitest": "0.5.4",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
